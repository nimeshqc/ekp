# Secrets — copy to .env (git-ignored) and fill in. Never put these in config.yaml.

# External LLM credential (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Admin portal login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs admin + proposal-link tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Database credential (used by docker-compose for the postgres service)
POSTGRES_PASSWORD=change-me-too

# Assembled DSN the API uses.
#  - docker compose:  postgresql://ekp:${POSTGRES_PASSWORD}@postgres:5432/ekp
#  - local dev:       postgresql://ekp:${POSTGRES_PASSWORD}@localhost:5432/ekp
DATABASE_URL=postgresql://ekp:change-me-too@postgres:5432/ekp
